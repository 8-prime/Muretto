# Maintainer: 8-prime <stefan@hoffmeister.dev>
#
# The template for the AUR package. `cargo make aur VERSION` (publish.sh)
# sets the version and checksums in a clone of the AUR repository and
# pushes it; the checksums here stay SKIP.
pkgname=muretto-bin
pkgver=0.0.1
pkgrel=1
# Where the icon and licence come from: the release's tag.
_ref=v$pkgver
pkgdesc="A launcher and content manager for Assetto Corsa"
arch=('x86_64')
url="https://github.com/8-prime/Muretto"
license=('MIT')
depends=('glibc' 'gcc-libs' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'wayland' 'vulkan-icd-loader')
provides=('muretto')
conflicts=('muretto')
source=("muretto-$pkgver::$url/releases/download/v$pkgver/muretto-linux-x86_64"
        "muretto-$_ref.svg::https://raw.githubusercontent.com/8-prime/Muretto/$_ref/crates/app/assets/icon/muretto.svg"
        "LICENSE-$_ref::https://raw.githubusercontent.com/8-prime/Muretto/$_ref/LICENSE")
sha256sums=('SKIP'
            'SKIP'
            'SKIP')

package() {
  install -Dm755 "muretto-$pkgver" "$pkgdir/usr/bin/muretto"
  install -Dm644 "muretto-$_ref.svg" \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/dev.muretto.Muretto.svg"
  install -Dm644 "LICENSE-$_ref" "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 /dev/stdin "$pkgdir/usr/share/applications/dev.muretto.Muretto.desktop" <<DESKTOP
[Desktop Entry]
Type=Application
Name=Muretto
Comment=Launcher and content manager for Assetto Corsa
Exec=muretto
Icon=dev.muretto.Muretto
Terminal=false
Categories=Game;
StartupWMClass=dev.muretto.Muretto
DESKTOP
}
